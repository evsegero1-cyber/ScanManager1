<resources>
    <style name="Theme.ScanManager" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.ScanManager.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1E5BD8</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ScanManager</item>
    </style>
</resources>
